{
  "name": "veyra",
  "version": "0.1.0",
  "private": true,
  "description": "Reversible execution for AI agents.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tang-vu/veyra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tang-vu/veyra.git"
  },
  "bugs": {
    "url": "https://github.com/tang-vu/veyra/issues"
  },
  "keywords": [
    "ai-agents",
    "reversible-execution",
    "capability-security",
    "audit-trail",
    "rust"
  ],
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test && pnpm test:release-assets",
    "test:release-assets": "node --test ./scripts/tests/*.test.mjs",
    "lint": "pnpm -r lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "oss:check": "node ./scripts/check-oss.mjs",
    "oss:host-check": "node ./scripts/check-github.mjs",
    "package:check": "node ./scripts/check-packages.mjs && node ./scripts/check-package-publication.mjs",
    "release:check": "node ./scripts/check-release.mjs",
    "release:verify-assets": "node ./scripts/verify-release-assets.mjs",
    "eval": "node ./evals/run.mjs",
    "desktop:dev": "pnpm --filter @veyra/desktop tauri dev",
    "desktop:build": "pnpm --filter @veyra/desktop tauri build"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
