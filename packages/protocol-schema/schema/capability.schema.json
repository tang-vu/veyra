{
  "x-veyra-protocol": "veyra.protocol/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability",
  "description": "A scoped, expiring grant of tool authority.",
  "type": "object",
  "properties": {
    "adapter": {
      "description": "Exact adapter.",
      "type": "string"
    },
    "constraints": {
      "description": "Enforced policy constraints.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "expires_at": {
      "description": "Grant is invalid at or after this timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "description": "Stable capability identifier.",
      "$ref": "#/$defs/CapabilityId"
    },
    "intent_id": {
      "description": "Optional intent binding.",
      "anyOf": [
        {
          "$ref": "#/$defs/IntentId"
        },
        {
          "type": "null"
        }
      ]
    },
    "issued_at": {
      "description": "Creation timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "max_uses": {
      "description": "Maximum successful effect authorizations.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "nonce": {
      "description": "Unique anti-replay nonce.",
      "type": "string"
    },
    "not_before": {
      "description": "Grant is invalid before this timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "operations": {
      "description": "Allowed operations.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "principal_id": {
      "description": "Principal to whom the grant is bound.",
      "$ref": "#/$defs/PrincipalId"
    },
    "resources": {
      "description": "Allowed resource scopes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceScope"
      }
    },
    "transaction_id": {
      "description": "Optional transaction binding.",
      "anyOf": [
        {
          "$ref": "#/$defs/TransactionId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "principal_id",
    "adapter",
    "operations",
    "resources",
    "constraints",
    "not_before",
    "expires_at",
    "nonce",
    "max_uses",
    "issued_at"
  ],
  "$defs": {
    "CapabilityId": {
      "description": "Stable identifier for a `CapabilityId` domain object.",
      "type": "string",
      "format": "uuid"
    },
    "IntentId": {
      "description": "Stable identifier for a `IntentId` domain object.",
      "type": "string",
      "format": "uuid"
    },
    "PrincipalId": {
      "description": "Stable identifier for a `PrincipalId` domain object.",
      "type": "string",
      "format": "uuid"
    },
    "ResourceScope": {
      "description": "An exact or prefix-bounded resource identifier.",
      "oneOf": [
        {
          "description": "A normalized path relative to a named workspace root.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem"
            },
            "path": {
              "description": "Normalized path relative to the workspace.",
              "type": "string"
            },
            "workspace": {
              "description": "Configured workspace name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "workspace",
            "path"
          ]
        },
        {
          "description": "Multiple exact paths in one workspace, used by operations such as move.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem_set"
            },
            "paths": {
              "description": "Ordered, normalized paths relative to the workspace.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workspace": {
              "description": "Configured workspace name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "workspace",
            "paths"
          ]
        },
        {
          "description": "An HTTP origin and path prefix.",
          "type": "object",
          "properties": {
            "domain": {
              "description": "Lowercase DNS name without credentials.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "http"
            },
            "path_prefix": {
              "description": "Normalized absolute path prefix.",
              "type": "string"
            },
            "port": {
              "description": "Explicit non-default port.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "scheme": {
              "description": "Lowercase `http` or `https` scheme.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "scheme",
            "domain",
            "path_prefix"
          ]
        },
        {
          "description": "An exact executable and normalized working directory.",
          "type": "object",
          "properties": {
            "executable": {
              "description": "Exact configured executable identifier or canonical path.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "process"
            },
            "workdir": {
              "description": "Normalized configured working directory.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "executable",
            "workdir"
          ]
        },
        {
          "description": "Extension namespace for third-party adapters.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "generic"
            },
            "namespace": {
              "description": "Globally unique adapter namespace.",
              "type": "string"
            },
            "resource": {
              "description": "Adapter-defined normalized resource identifier.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "namespace",
            "resource"
          ]
        }
      ]
    },
    "TransactionId": {
      "description": "Stable identifier for a `TransactionId` domain object.",
      "type": "string",
      "format": "uuid"
    }
  }
}
