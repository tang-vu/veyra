{
  "x-veyra-protocol": "veyra.protocol/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalRequest",
  "description": "Approval challenge containing the immutable effect content digest.",
  "type": "object",
  "properties": {
    "created_at": {
      "description": "Creation timestamp.",
      "type": "string",
      "format": "date-time"
    },
    "effect_digest": {
      "description": "Canonical digest of the complete preflighted effect.",
      "type": "string"
    },
    "effect_id": {
      "description": "Bound effect.",
      "$ref": "#/$defs/EffectId"
    },
    "expires_at": {
      "description": "Challenge expiry.",
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "description": "Stable request identifier.",
      "$ref": "#/$defs/ApprovalRequestId"
    },
    "nonce": {
      "description": "Unique anti-replay nonce.",
      "type": "string"
    },
    "preview": {
      "description": "Preflight preview shown to the approver.",
      "$ref": "#/$defs/Preview"
    },
    "resource": {
      "description": "Exact scope shown to the approver.",
      "$ref": "#/$defs/ResourceScope"
    },
    "risk": {
      "description": "Risk shown to the approver.",
      "$ref": "#/$defs/RiskLevel"
    },
    "transaction_id": {
      "description": "Bound transaction.",
      "$ref": "#/$defs/TransactionId"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "transaction_id",
    "effect_id",
    "effect_digest",
    "risk",
    "resource",
    "preview",
    "nonce",
    "created_at",
    "expires_at"
  ],
  "$defs": {
    "ApprovalRequestId": {
      "description": "Stable identifier for a `ApprovalRequestId` domain object.",
      "type": "string",
      "format": "uuid"
    },
    "EffectId": {
      "description": "Stable identifier for a `EffectId` domain object.",
      "type": "string",
      "format": "uuid"
    },
    "Preview": {
      "description": "Structured effect preview.",
      "oneOf": [
        {
          "description": "Filesystem diff or operation description.",
          "type": "object",
          "properties": {
            "after_sha256": {
              "description": "Proposed digest, if the path will exist.",
              "type": [
                "string",
                "null"
              ]
            },
            "before_sha256": {
              "description": "Original digest, if the path exists.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "filesystem"
            },
            "operation": {
              "description": "Filesystem operation.",
              "type": "string"
            },
            "path": {
              "description": "Workspace-relative path.",
              "type": "string"
            },
            "unified_diff": {
              "description": "Bounded UTF-8 unified diff when content is textual.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "operation",
            "path"
          ]
        },
        {
          "description": "Redacted outbound HTTP request.",
          "type": "object",
          "properties": {
            "body_sha256": {
              "description": "Digest of the outbound body, if present.",
              "type": [
                "string",
                "null"
              ]
            },
            "headers": {
              "description": "Headers with credential values replaced by markers.",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "http"
            },
            "method": {
              "description": "Uppercase HTTP method.",
              "type": "string"
            },
            "url": {
              "description": "Allowlisted URL without user information.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "method",
            "url",
            "headers"
          ]
        },
        {
          "description": "Exact argv without shell interpolation.",
          "type": "object",
          "properties": {
            "args": {
              "description": "Exact argument vector.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "environment_keys": {
              "description": "Names, but never values, of passed environment entries.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "executable": {
              "description": "Exact executable.",
              "type": "string"
            },
            "executable_sha256": {
              "description": "SHA-256 of the executable bytes observed during preflight.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "process"
            },
            "workdir": {
              "description": "Exact working directory.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "executable",
            "executable_sha256",
            "args",
            "workdir",
            "environment_keys"
          ]
        },
        {
          "description": "Safe adapter-defined preview.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "custom"
            },
            "media_type": {
              "description": "Versioned media type describing the value.",
              "type": "string"
            },
            "value": {
              "description": "Secret-safe preview body."
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "media_type",
            "value"
          ]
        },
        {
          "description": "Planner placeholder. Preflight must replace this before approval.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pending"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ResourceScope": {
      "description": "An exact or prefix-bounded resource identifier.",
      "oneOf": [
        {
          "description": "A normalized path relative to a named workspace root.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem"
            },
            "path": {
              "description": "Normalized path relative to the workspace.",
              "type": "string"
            },
            "workspace": {
              "description": "Configured workspace name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "workspace",
            "path"
          ]
        },
        {
          "description": "Multiple exact paths in one workspace, used by operations such as move.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem_set"
            },
            "paths": {
              "description": "Ordered, normalized paths relative to the workspace.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workspace": {
              "description": "Configured workspace name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "workspace",
            "paths"
          ]
        },
        {
          "description": "An HTTP origin and path prefix.",
          "type": "object",
          "properties": {
            "domain": {
              "description": "Lowercase DNS name without credentials.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "http"
            },
            "path_prefix": {
              "description": "Normalized absolute path prefix.",
              "type": "string"
            },
            "port": {
              "description": "Explicit non-default port.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "scheme": {
              "description": "Lowercase `http` or `https` scheme.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "scheme",
            "domain",
            "path_prefix"
          ]
        },
        {
          "description": "An exact executable and normalized working directory.",
          "type": "object",
          "properties": {
            "executable": {
              "description": "Exact configured executable identifier or canonical path.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "process"
            },
            "workdir": {
              "description": "Normalized configured working directory.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "executable",
            "workdir"
          ]
        },
        {
          "description": "Extension namespace for third-party adapters.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "generic"
            },
            "namespace": {
              "description": "Globally unique adapter namespace.",
              "type": "string"
            },
            "resource": {
              "description": "Adapter-defined normalized resource identifier.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "namespace",
            "resource"
          ]
        }
      ]
    },
    "RiskLevel": {
      "description": "Severity used for policy and UI decisions.",
      "oneOf": [
        {
          "description": "Read-only or readily restored work with narrow scope.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Mutating but bounded work with reliable recovery.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "Broad, externally visible, or best-effort recoverable work.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Irreversible or safety-critical work.",
          "type": "string",
          "const": "critical"
        }
      ]
    },
    "TransactionId": {
      "description": "Stable identifier for a `TransactionId` domain object.",
      "type": "string",
      "format": "uuid"
    }
  }
}
